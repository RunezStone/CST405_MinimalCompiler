.text
.globl main

main:
    # Allocate global stack frame
    addi $sp, $sp, -400

    # Declare float x at offset 0
    # Declare float y at offset 4
    # Declare float z at offset 8
    la   $t0, _fc0
    lwc1 $f0, 0($t0)
    swc1 $f0, 0($sp)   # x = ...
    la   $t0, _fc1
    lwc1 $f0, 0($t0)
    swc1 $f0, 4($sp)   # y = ...
    lwc1 $f0, 0($sp)   # float x
    lwc1 $f2, 4($sp)   # float y
    add.s $f0, $f0, $f2
    swc1 $f0, 8($sp)   # z = ...
    lwc1 $f0, 8($sp)   # float z
    # Print float
    mov.s $f12, $f0
    li    $v0, 2
    syscall
    # Print newline
    li   $v0, 11
    li   $a0, 10
    syscall
    lwc1 $f0, 0($sp)   # float x
    # Print float
    mov.s $f12, $f0
    li    $v0, 2
    syscall
    # Print newline
    li   $v0, 11
    li   $a0, 10
    syscall

    # Exit program
    addi $sp, $sp, 400
    li   $v0, 10
    syscall
