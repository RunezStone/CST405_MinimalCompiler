# Three-Address Code (TAC) - Unoptimized
# ─────────────────────────────────────

 1: DECL int a
 2: DECL int b
 3: DECL int result
 4: FUNC_BEGIN Program_Start
 5: a = 10
 6: b = 3
 7: t0 = a + b
 8: t2 = a - b
 9: t1 = t0 * t2
10: t3 = t1 / 2
11: result = t3
12: PRINT result
13: FUNC_END Program_Start
