// ======================================================================
// algorithms_museum.oom
//
// A museum of classic integer algorithms, rewritten to fit the actual
// OOMini grammar. The original "kitchen sink" version relied on arrays,
// dynamic lists, stacks, queues and sorting -- none of which this language
// has. This version sticks to what the compiler really supports:
//
//   - classes with fields and methods            (encapsulation)
//   - single inheritance via 'extends'           (code reuse)
//   - method overriding + vtable dispatch        (runtime polymorphism)
//   - 'self', constructors (init) + 'new'        (objects on the heap)
//   - while / if / else, integer arithmetic      (control flow)
//
// NOT used (the language does not have them): arrays, floats, for-loops,
// strings, the % operator, and boolean && / || / !.
//
// 'print' can only print a single integer, so each exhibit prints its
// numeric result. Expected values are noted next to each call in main().
// ======================================================================


// ----------------------------------------------------------------------
// MathUtil: shared integer helpers. Almost everything extends this, so
// every class inherits mod / absVal / isEven and a no-op constructor.
// ----------------------------------------------------------------------
class MathUtil {

    func void init() {
        // nothing to set up; lets 'new X()' work for helper classes
        return;
    }

    func int mod(int a, int b) {
        // remainder of a / b  (no '%' operator in this language)
        return a - (a / b) * b;
    }

    func int absVal(int x) {
        if (x < 0) {
            return 0 - x;
        }
        return x;
    }

    func int isEven(int x) {
        if (self.mod(x, 2) == 0) {
            return 1;
        }
        return 0;
    }
}


// ----------------------------------------------------------------------
// Exhibit: the polymorphic base of the museum. Every exhibit overrides
// compute(); the inherited show() calls self.compute(), so the right
// algorithm runs through vtable dispatch -- that is the polymorphism demo.
// ----------------------------------------------------------------------
class Exhibit extends MathUtil {

    func int compute(int n) {
        // base version, overridden by each exhibit below
        return 0;
    }

    func void show(int n) {
        // dynamic dispatch: picks the subclass's compute() at runtime
        print(self.compute(n));
    }
}


// ---- Factorial: n! = 1 * 2 * ... * n ----
class Factorial extends Exhibit {
    func int compute(int n) {
        int result;
        int i;
        result = 1;
        i = 2;
        while (i <= n) {
            result = result * i;
            i = i + 1;
        }
        return result;
    }
}


// ---- Fibonacci: the nth Fibonacci number (fib(0)=0, fib(1)=1) ----
class Fibonacci extends Exhibit {
    func int compute(int n) {
        int a;
        int b;
        int t;
        int i;
        a = 0;
        b = 1;
        i = 0;
        while (i < n) {
            t = a + b;
            a = b;
            b = t;
            i = i + 1;
        }
        return a;
    }
}


// ---- Triangular: 1 + 2 + ... + n ----
class Triangular extends Exhibit {
    func int compute(int n) {
        int sum;
        int i;
        sum = 0;
        i = 1;
        while (i <= n) {
            sum = sum + i;
            i = i + 1;
        }
        return sum;
    }
}


// ---- Prime: returns 1 if n is prime, else 0 ----
class Prime extends Exhibit {
    func int compute(int n) {
        int i;
        if (n < 2) {
            return 0;
        }
        i = 2;
        while (i * i <= n) {
            if (self.mod(n, i) == 0) {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }
}


// ---- Isqrt: largest k with k*k <= n (integer square root) ----
class Isqrt extends Exhibit {
    func int compute(int n) {
        int k;
        k = 0;
        while ((k + 1) * (k + 1) <= n) {
            k = k + 1;
        }
        return k;
    }
}


// ---- DigitSum: sum of the base-10 digits of n ----
class DigitSum extends Exhibit {
    func int compute(int n) {
        int sum;
        int x;
        x = self.absVal(n);
        sum = 0;
        while (x > 0) {
            sum = sum + self.mod(x, 10);
            x = x / 10;
        }
        return sum;
    }
}


// ---- Reverse: digits of n reversed (1234 -> 4321) ----
class Reverse extends Exhibit {
    func int compute(int n) {
        int rev;
        int x;
        x = self.absVal(n);
        rev = 0;
        while (x > 0) {
            rev = rev * 10 + self.mod(x, 10);
            x = x / 10;
        }
        return rev;
    }
}


// ---- Collatz: number of steps to reach 1 ----
class Collatz extends Exhibit {
    func int compute(int n) {
        int steps;
        int x;
        x = n;
        steps = 0;
        while (x > 1) {
            if (self.isEven(x) == 1) {
                x = x / 2;
            } else {
                x = 3 * x + 1;
            }
            steps = steps + 1;
        }
        return steps;
    }
}


// ---- Divisors: how many positive integers divide n ----
class Divisors extends Exhibit {
    func int compute(int n) {
        int count;
        int i;
        count = 0;
        i = 1;
        while (i <= n) {
            if (self.mod(n, i) == 0) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }
}


// ----------------------------------------------------------------------
// Pairwise: algorithms that need two inputs, so they do not fit the
// single-argument compute() interface. Still reuses MathUtil's helpers.
// ----------------------------------------------------------------------
class Pairwise extends MathUtil {

    func int gcd(int a, int b) {
        int t;
        a = self.absVal(a);
        b = self.absVal(b);
        while (b != 0) {
            t = self.mod(a, b);
            a = b;
            b = t;
        }
        return a;
    }

    func int lcm(int a, int b) {
        return a / self.gcd(a, b) * b;
    }

    func int power(int base, int exp) {
        int result;
        int i;
        result = 1;
        i = 0;
        while (i < exp) {
            result = result * base;
            i = i + 1;
        }
        return result;
    }
}


// ----------------------------------------------------------------------
// main: walk the museum. Each exhibit is created with 'new', then run.
// The show() calls demonstrate polymorphism; the Pairwise calls show
// plain two-argument methods. Expected output is in the comments.
// ----------------------------------------------------------------------
func void main() {
    Factorial fact;
    Fibonacci fib;
    Triangular tri;
    Prime prime;
    Isqrt root;
    DigitSum dsum;
    Reverse rev;
    Collatz col;
    Divisors div;
    Pairwise pair;

    fact = new Factorial();
    fib = new Fibonacci();
    tri = new Triangular();
    prime = new Prime();
    root = new Isqrt();
    dsum = new DigitSum();
    rev = new Reverse();
    col = new Collatz();
    div = new Divisors();
    pair = new Pairwise();

    fact.show(5);       // 120   = 5!
    fib.show(10);       // 55    = fib(10)
    tri.show(10);       // 55    = 1+2+...+10
    prime.show(17);     // 1     = 17 is prime
    prime.show(15);     // 0     = 15 is not prime
    root.show(50);      // 7     = floor(sqrt(50))
    dsum.show(12345);   // 15    = 1+2+3+4+5
    rev.show(1234);     // 4321  = digits reversed
    col.show(6);        // 8     = Collatz steps from 6
    div.show(12);       // 6     = divisors of 12

    print(pair.gcd(48, 36));    // 12
    print(pair.lcm(4, 6));      // 12
    print(pair.power(2, 10));   // 1024
}